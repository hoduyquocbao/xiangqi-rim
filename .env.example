# ============================================================================
# XIANGQI-RIM ENVIRONMENT VARIABLES
# ============================================================================
# Sao chép tệp này thành `.env` và điền giá trị thực:
#   cp .env.example .env
#
# NGHIÊM CẤM commit tệp `.env` lên Git (đã có trong .gitignore).
# ============================================================================

# HuggingFace Write Token (bắt buộc để upload dữ liệu/trọng số lên Hub)
# Tạo token tại: https://huggingface.co/settings/tokens (quyền "write")
HF_TOKEN=hf_your_write_token_here

# HuggingFace Dataset Repository
HF_REPO=hoduyquocbao/xiangqi-r1-dataset

# Cấu hình Mining
GAMES=500
DEPTH=4
THREADS=8
